{
  "name": "deal-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/t/*"] },
  "durable_objects": { "bindings": [{ "name": "DEAL", "class_name": "DealRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DealRoom"] }],
  "observability": { "enabled": true }
}
